  "display": {
    "formats": {
      "multiSend(bytes transactions)": {
        "intent": "Batch",
        "fields": [
          {
            "path": "transactions",
            "label": "",
            "format": "customEncoding",
            "params": {
              "type": "sequence",
              "element": {
                "type": "object",
                "entries": [
                  {
                    "name": "operation",
                    "schema": {
                      "type": "uint",
                      "bytes": 1
                    }
                  },
                  {
                    "name": "to",
                    "schema": {
                      "type": "address",
                      "bytes": 20
                    }
                  },
                  {
                    "name": "value",
                    "schema": {
                      "type": "uint",
                      "bytes": 32
                    }
                  },
                  {
                    "name": "dataLength",
                    "schema": {
                      "type": "uint",
                      "bytes": 32
                    }
                  },
                  {
                    "name": "data",
                    "schema": {
                      "type": "bytes",
                      "lengthFrom": "dataLength"
                    },
                    "label": "",
                    "format": "calldata",
                    "params": {
                      "calleePath": "~.to",
                      "amountPath": "~.value",
                      "operation": {
                        "expression": "~.operation",
                        "cases": {
                          "0x01": "DELEGATECALL",
                          "$default": "CALL"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        ]
      }

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- @wedgiechatbot (bot/telegram.mjs). Install: cp to ~/Library/LaunchAgents/, launchctl load -w it. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.wedgie.telegram-bot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/clawd/clawd-harness/projects/wedgie-dev/bot/telegram.mjs</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/clawd/Library/Logs/wedgie-telegram-bot.log</string>
  <key>StandardErrorPath</key><string>/Users/clawd/Library/Logs/wedgie-telegram-bot.log</string>
</dict>
</plist>
